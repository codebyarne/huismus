{
  "permissions": {
    "allow": [
      "Bash(./scripts/verify.sh)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python manage.py makemigrations --check:*)",
      "Bash(uv run python manage.py makemessages:*)",
      "Bash(uv run python manage.py compilemessages:*)",
      "Bash(SECRET_KEY=dev DEBUG=true uv run python manage.py makemigrations --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./data-import/**)",
      "Read(./data/**)",
      "Read(./.env)",
      "Read(./**/*.sqlite3)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-gate.sh",
            "timeout": 600,
            "statusMessage": "Verify-poort controleren..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/playbook-sync.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
