msgstr "subject in Dutch"

msgid "tekst in het Nederlands"
msgstr "text in Dutch"

msgid "onderwerp in het Engels"
msgstr "subject in English"

msgid "tekst in het Engels"
msgstr "text in English"

msgid "Wachtwoord"
msgstr "Password"

msgid "KOR-grens"
msgstr "KOR limit"

msgid "Nummering elk jaar opnieuw beginnen"
msgstr "Restart numbering every year"

#, python-brace-format
msgid "Zet {seq} in het formaat, voor het volgnummer."
msgstr "Put {seq} in the format, for the sequence number."

#, python-brace-format
msgid ""
"Dit formaat klopt niet. Gebruik {year} voor het jaar en {seq:04d} voor het "
"volgnummer."
msgstr ""
"This format isn't valid. Use {year} for the year and {seq:04d} for the "
"sequence number."

#, python-brace-format
msgid ""
"Met {year} in het formaat moet de nummering elk jaar opnieuw beginnen. Zet "
"dat aan, of haal {year} weg."
msgstr ""
"With {year} in the format, numbering has to restart every year. Switch that "
"on, or remove {year}."

#, python-brace-format
msgid ""
"Met {year} in het formaat moet de nummering elk jaar opnieuw beginnen. Haal "
"{year} weg."
msgstr ""
"With {year} in the format, numbering has to restart every year. Remove "
"{year}."

#, python-format
msgid "Huismus kent %(unknown)s niet. Je kunt gebruiken: %(known)s."
msgstr "Huismus doesn't know %(unknown)s. You can use: %(known)s."

msgid "Vul je Gmail-adres in."
msgstr "Enter your Gmail address."

msgid "Vul dit in om via je eigen mailserver te mailen."
msgstr "Fill this in to mail through your own mail server."

#, python-format
msgid "Dit logo is groter dan %(max_mb)s MB. Kies een kleiner bestand."
msgstr "This logo is larger than %(max_mb)s MB. Choose a smaller file."

msgid "Kies een PNG-, JPG- of SVG-bestand."
msgstr "Choose a PNG, JPG or SVG file."

msgid ""
"Huismus kan dit bestand niet als afbeelding openen. Kies een ander bestand."
msgstr "Huismus can't open this file as an image. Choose another file."

#, python-format
msgid ""
"Dit bestand eindigt op .%(extension)s, maar is geen %(extension)s-bestand. "
"Kies een ander bestand."
msgstr ""
"This file ends in .%(extension)s, but it isn't a %(extension)s file. Choose "
"another file."

